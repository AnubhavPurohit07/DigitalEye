# Copy this file to agent.properties and fill in the password.
# (scripts\setup.cmd does this for you.) agent.properties is ignored by git - never commit it.

# Address of the backend. Must match server.port in the backend's application.properties.
backend.url=http://localhost:9090

# A regular USER-role account (not the admin account) that this agent logs in as.
# scripts\create-users.cmd creates it for you after the backend is running.
agent.username=employee1
agent.password=CHANGE_ME

# How often (seconds) the agent re-sends its current state. The backend marks
# a system OFFLINE after about 90 seconds without hearing from it.
agent.heartbeat.seconds=20

# Screenshots. An administrator asks for one by clicking "Take Screenshot" on the
# dashboard; the agent checks for such requests every few seconds, takes one screenshot
# and prints a message here each time. Set screenshot.enabled=false to never take any.
screenshot.enabled=true
agent.command.poll.seconds=3
# Automatic screenshots are OFF (0). Set a number of seconds (5 or more) to turn them on.
screenshot.interval.seconds=0
# Wider screenshots are scaled down to this width before upload.
screenshot.max.width=1280
# JPEG quality, 0.1 (smallest) to 1.0 (best).
screenshot.quality=0.6
