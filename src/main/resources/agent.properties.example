# Backend connection settings for the agent.
# backend.url must match whatever port DigitalEyeBackendApplication is
# actually running on - this machine currently uses 9090.
backend.url=http://localhost:9090

# A regular USER-role account (not the admin account) that this agent
# logs in as. Register one first via /api/auth/register with "role":"USER" -
# see the agent README for the exact command.
agent.username=employee1
agent.password=CHANGE_ME
